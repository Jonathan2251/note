Build llvm 22.1.0 setting libc++ and lld as default:

cmake -G “Unix Makefiles” -DCMAKE_INSTALL_PREFIX=/opt/llvm -DCMAKE_BUILD_TYPE=Release -DLLVM_ENABLE_PROJECTS=“clang;lld” -DCLANG_ENABLE_BOOTSTRAPE=“On” -DCLANG_BOOTSTRAP_CMAKE_ARGS= “-G Unix Makefiles;-DLLVM_ENABLE_LLD=ON:-DLLVM_ENABLE_RUNTIMES=libcxx;libcxxabi;libunwind” -DCLANG_DEFAULT_LINKER=lld -DCLANG_DEFAULT_CXX_STDLIB=libc++ ../llvm/llvm

clang++ -v test.cpp
